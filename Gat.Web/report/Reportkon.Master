<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Reportkon.Master.cs" Inherits="Gat.Web.report.Reportkon" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <script src="/scripts/jquery-1.10.2.min.js"></script>
    <link href="/styles/default.css?v=20220920" rel="stylesheet" type="text/css" />
    <!--导航-->
    <link href="/scripts/sexydropdown/sexydropdownmenu.css" rel="stylesheet" type="text/css" />
    <!--自定义-->
    <script src="/scripts/gat/utils.js" type="text/javascript"></script>
    <script src="/scripts/gat/reportmaster.js" type="text/javascript"></script>
    <!--dialog-->
    <script src="/scripts/jquery.yuan/jquery.yuanyuan.js" type="text/javascript"></script>
    <link href="/scripts/jquery.yuan/yuanyuan.css" rel="stylesheet" type="text/css" />
    <!--文本水印-->
    <script src="/scripts/jquery.watermark-3.1.3/jquery.watermark.min.js" type="text/javascript"></script>

    <asp:ContentPlaceHolder ID="cpHeader" runat="server">
    </asp:ContentPlaceHolder>

</head>
<body>
    <form id="form1" runat="server">
        <!--顶部-->
        <div class="top-outer">
            <div class="top-inner">
                <div class="top-wrapper">
                    <div class="top-logout ">
                        <div class="l">
                            <span style="color: #FF6600; font-weight: bold;">供应商</span>：
                    <asp:DropDownList ID="ddlVendor" runat="server" CssClass="select" Style="line-height: 15px; margin: 2px 0 2px 5px;">
                    </asp:DropDownList>
                        </div>
                        <!--&nbsp;&nbsp;&nbsp;&nbsp;-->
                        <div class="r">
                            <asp:ContentPlaceHolder ID="cpTop" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--LOGO区-->
        <div class="logo-bar">
            <div class="logo l">
                <div class="logo-hk l">&nbsp;</div>
                <div class="logo-title l">
                    <asp:Label ID="lblTopTitle" runat="server" CssClass="top-title" />
                    <asp:Label ID="lblSubTitle" runat="server" CssClass="sub-title" />
                </div>
            </div>
            <div style="float: right;">
                <asp:ContentPlaceHolder ID="cpHeaderNav" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>

        <!--导航区-->
        <div class="nav-bar">
            <div class="nav-inner">
                <%=this.Navigate%>
            </div>
        </div>

        <!--二次导航区-->
        <!--目前只有阿迪全渠道使用-->
        <div class="secondary-nav-bar">
            <div class="secondary-nav-inner">
                <%=this.SecondaryNavigate%>
            </div>
        </div>

        <div class="content">
            <asp:ContentPlaceHolder ID="cpBody" runat="server"></asp:ContentPlaceHolder>
        </div>

        <div class="action">
            <asp:ContentPlaceHolder ID="cpAction" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

</body>
</html>
