	[Saletype] [varchar](40) NOT NULL,--销售类型
	[CardID] [varchar](20) NULL,--品牌ID
	[ShopID] [varchar](50) NULL,
	[ShopCode] [varchar](50) NULL,--店铺代码
	[PostJaon] [text] NULL,
	[ReturnJson] [text] NULL,
	[IsSuccess] [bit] NOT NULL,
	[CreateDtm] [datetime] NOT NULL,
	[ModifyDtm] [datetime] NOT NULL,
	[Qty] [int] NULL,--数量
	[Amount] [decimal](24, 6) NULL,--订单总金额（POS单总结算金额）
	[IsImport] [bit] NULL,
	[Mall] [varchar](50) NULL,--商场编码
 CONSTRAINT [PK_Gat_ArcTeryx_PosSale] PRIMARY KEY CLUSTERED 
(
	[ID] ASC,
	[SolutionId] ASC,
	[CompanyID] ASC,
	[BillNo] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRIMARY]
) ON [PRIMARY] TEXTIMAGE_ON [PRIMARY]
end


