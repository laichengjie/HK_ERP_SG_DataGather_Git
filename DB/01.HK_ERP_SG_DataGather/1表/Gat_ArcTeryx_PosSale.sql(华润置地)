IF NOT Exists(select top 1 * from sysObjects where Id=OBJECT_ID(N'Gat_ArcTeryx_PosSale') and xtype='U')
BEGIN
CREATE TABLE [dbo].[Gat_ArcTeryx_PosSale](
	[ID] [int] IDENTITY(1,1) NOT NULL,
	[SolutionId] [int] NOT NULL,
	[CompanyID] [varchar](20) NOT NULL,
	[BillNo] [varchar](40) NOT NULL,
	[CashierId] [varchar](40) NOT NULL,--品牌方 收银员编码
	[CheckCode] [varchar](40) NOT NULL,-- 品牌方 店铺验证密钥
