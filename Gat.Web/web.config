    <authentication mode="Forms">
      <forms loginUrl="/login" protection="All" timeout="600" name=".WEXIAOSHEN" path="/" requireSSL="false" slidingExpiration="true" defaultUrl="/default" cookieless="UseDeviceProfile" enableCrossAppRedirects="false" />
    </authentication>
    <httpRuntime maxRequestLength="512000" executionTimeout="1800" appRequestQueueLimit="100" requestPathInvalidCharacters="&lt;,&gt;" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
