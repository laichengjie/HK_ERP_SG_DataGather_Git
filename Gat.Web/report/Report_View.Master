<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Report_View.Master.cs" Inherits="Gat.Web.report.Report_View" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <script src="/scripts/jquery.min.1.6.2.js" type="text/javascript"></script>
    <link href="/styles/default.css" rel="stylesheet" type="text/css" />
    <!--导航-->
    <link href="/scripts/sexydropdown/sexydropdownmenu.css" rel="stylesheet" type="text/css" />
    <!--自定义-->
    <script src="/scripts/gat/utils.js" type="text/javascript"></script>
    <script src="/scripts/gat/reportmaster.js" type="text/javascript"></script>
    <!--kendoui-->
    <link href="/scripts/kendoui/styles/kendo.common.min.css" rel="stylesheet" type="text/css" />
    <link href="/scripts/kendoui/styles/kendo.kendo.min.css" rel="stylesheet" type="text/css" />
    <script src="/scripts/kendoui/js/kendo.all.min.js" type="text/javascript"></script>
    <script src="/scripts/kendoui/js/cultures/kendo.culture.zh-CN.js" type="text/javascript"></script>
    <!--dialog-->
    <script src="/scripts/jquery.yuan/jquery.yuanyuan.js" type="text/javascript"></script>
    <link href="/scripts/jquery.yuan/yuanyuan.css" rel="stylesheet" type="text/css" />
    <!--文本水印-->
    <script src="/scripts/jquery.watermark-3.1.3/jquery.watermark.min.js" type="text/javascript"></script>
    <!--分页器-->
    <script src="/scripts/jquery.pager/jquery.pager.js" type="text/javascript"></script>
    <link href="/scripts/jquery.pager/pager.css" rel="stylesheet" type="text/css" />

    <!--jquery.validate-->
    <script src="/scripts/jquery.validate/jquery.validate.js" type="text/javascript"></script>
    <script src="/scripts/jquery.validate/jquery.validate.additional.js" type="text/javascript"></script>
    <!--jquery.ui.button-->
    <script src="/scripts/jquery.ui-1.8.16/development-bundle/ui/minified/jquery.ui.core.min.js" type="text/javascript"></script>
    <script src="/scripts/jquery.ui-1.8.16/development-bundle/ui/minified/jquery.ui.widget.min.js" type="text/javascript"></script>
    <script src="/scripts/jquery.ui-1.8.16/development-bundle/ui/minified/jquery.ui.button.min.js" type="text/javascript"></script>
    <link href="/scripts/jquery.ui-1.8.16/css/ui-lightness/jquery-ui-1.8.16.custom.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .top-wrapper {
            width:100%;
        }
        /*datepicker*/
        .k-timepicker,
        .k-datetimepicker,
        .k-datepicker {
            border: 0 none;
            white-space: nowrap;
            width: 215px;
        }
    </style>
    <asp:ContentPlaceHolder ID="cpHeader" runat="server">
    </asp:ContentPlaceHolder>

</head>
<body>
    <form id="form1" runat="server">
        <!--顶部-->
        <div class="top-outer">
            <div class="top-inner">
                <div class="top-wrapper">
                    <div class="top-logout ">
                        <div class="l">
                            <span style="color: #FF6600; font-weight: bold;">方案</span>：
                            <asp:DropDownList ID="ddlSoule" runat="server" CssClass="select">
                            </asp:DropDownList>
                            &nbsp;&nbsp;
                        </div>
                        <div class="l">
                            <span style="color: #FF6600; font-weight: bold;">日期</span>：
                            <asp:TextBox ID="txStarDate" runat="server" CssClass="datepicker"></asp:TextBox>
                            -
                            <asp:TextBox ID="txtEndDate" runat="server" CssClass="datepicker"></asp:TextBox>
                            &nbsp;&nbsp;
                        </div>
                        <div class="l">
                            <span style="color: #FF6600; font-weight: bold;">供应商</span>：
                            <asp:DropDownList ID="ddlVendor" runat="server" CssClass="select" Style="line-height: 15px; margin: 2px 0 2px 5px;">
                            </asp:DropDownList>
                        </div>
                        <!--&nbsp;&nbsp;&nbsp;&nbsp;-->
                        <div class="r">
                            <asp:ContentPlaceHolder ID="cpTop" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--LOGO区-->
        <div class="logo-bar">
            <div class="logo l">
                <div class="logo-hk l">&nbsp;</div>
                <div class="logo-title l">
                    <asp:Label ID="lblTopTitle" runat="server" CssClass="top-title" />
                    <asp:Label ID="lblSubTitle" runat="server" CssClass="sub-title" />
                </div>
            </div>
            <div style="float: right;">
                <asp:ContentPlaceHolder ID="cpHeaderNav" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>

        <!--导航区-->
        <div class="nav-bar">
            <div class="nav-inner">
                <%=this.Navigate%>
            </div>
        </div>

         <!--二次导航区-->
        <!--目前只有阿迪全渠道使用-->
        <div class="secondary-nav-bar">
            <div class="secondary-nav-inner">
                <%=this.SecondaryNavigate%>
            </div>
        </div>


        <div class="content">
            <asp:ContentPlaceHolder ID="cpBody" runat="server"></asp:ContentPlaceHolder>
        </div>

        <div class="action">
            <asp:ContentPlaceHolder ID="cpAction" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
    <script>
        jQuery(function ($) {
            $('input.datepicker')
          .eq(0)
          .css('width', '215px')
          .end()
          .bind('focus', function () {
              $(this).css('border', 'none')
          }).kendoDatePicker({
              format: 'yyyy-MM-dd HH:mm:ss',
              min: new Date(2000, 01, 01),
              open: function () {
                  $(document.body).addClass('overflow');
              },
              close: function () {
                  $(document.body).removeClass('overflow');
              }
          });
        });

    </script>
</body>
</html>
