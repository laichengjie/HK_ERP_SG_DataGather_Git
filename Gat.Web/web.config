    <add key="CardCompanyName" value="KAPPA(卡帕)" />
    <add key="ClientCode" value="YXT" />
    <add key="CardID" value="00000000000001" />
    <add key="CardCode" value="KAPPA" />
    <add key="CardName" value="KAPPA(卡帕)" />
    <!--允许多个供应商1：允许；0：不允许-->
    <add key="MultiVenor" value="0" />
    <!--上下文的Cookie-->
    <add key="deedy" value=".deedy" />
    <!--保存密码的COOKIE名称-->
    <add key="yuanyuan" value=".yuanyuan" />
    <!--报表上下文的COOKIE名称-->
    <add key="report" value=".yiting" />
    <!--对外接口配置-->
    <add key="userId" value="0001" />
    <add key="userPwd" value="123456" />
    <add key="BrandQueryCompanyID" value="JXTB" />
    <add key="BrandVendorID" value="9" />
    <add key="ConnStrUseDAT" value="false" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
