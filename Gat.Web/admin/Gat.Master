<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Gat.master.cs" Inherits="Gat.Web.admin.Gat" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <script src="/scripts/jquery.min.1.6.2.js" type="text/javascript"></script>
    <link href="/styles/default.css?v=20220920" rel="stylesheet" type="text/css" />
    <!--导航-->
    <link href="/scripts/sexydropdown/sexydropdownmenu.css" rel="stylesheet" type="text/css" />
    <!--自定义-->
    <script src="/scripts/gat/utils.js" type="text/javascript"></script>
    <script src="/scripts/gat/master.js" type="text/javascript"></script>
    <!--kendoui-->
    <link href="/scripts/kendoui/styles/kendo.common.min.css" rel="stylesheet" type="text/css" />
    <link href="/scripts/kendoui/styles/kendo.kendo.min.css" rel="stylesheet" type="text/css" />
    <script src="/scripts/kendoui/js/kendo.all.min.js" type="text/javascript"></script>
    <script src="/scripts/kendoui/js/cultures/kendo.culture.zh-CN.js" type="text/javascript"></script>
    <!--dialog-->
    <script src="/scripts/jquery.yuan/jquery.yuanyuan.js" type="text/javascript"></script>
    <link href="/scripts/jquery.yuan/yuanyuan.css" rel="stylesheet" type="text/css" />
    <!--文本水印-->
    <script src="/scripts/jquery.watermark-3.1.3/jquery.watermark.min.js" type="text/javascript"></script>
    <asp:ContentPlaceHolder ID="cpHeader" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!--顶部-->
        <div class="top-outer">
            <div class="top-inner">
                <div class="top-wrapper">
                    <div class="top-logout ">
                        <div class="l">
                            [&nbsp;
                    <a href="javascript:;" id='password-modify'>修改密码</a>
                            &ensp;/&ensp;
                    <a href="<%= this.GetRouteUrl("login", new { p = "1" }) %>" onclick="logoff">注销</a>&nbsp;
                    <script type="text/javascript">
                        function logoff() {
                            document.cookie = "<%=  Gat.Web.Common.CookieHelper.ContextCookieName%>=; expires=Thu, 01 Jan 1970 00:00:00 GMT";
                        }
                    </script>
                            ]
                        </div>
                        &nbsp;&nbsp;
                <div class="r">
                    <asp:ContentPlaceHolder ID="cpTop" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
                    </div>
                </div>
            </div>
        </div>
        <!--LOGO区-->
        <div class="logo-bar">
            <div class="logo l">
                <a href="<%= this.GetRouteUrl("default", new { p = "1" }) %>">
                    <div class="logo-hk l">&nbsp</div>
                </a>
                <div class="logo-title l">
                    <asp:Label ID="lblTopTitle" runat="server" CssClass="top-title" />
                    <asp:Label ID="lblSubTitle" runat="server" CssClass="sub-title" />
                </div>
            </div>
            <div style="float: right;">
                <asp:ContentPlaceHolder ID="cpHeaderNav" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>

        <!--导航区-->
        <div class="nav-bar">
            <div class="nav-inner">
                <ul>
                    <li><a href="<%= this.GetRouteUrl("default", new { }) %>">平台首页</a></li>
                    <li>
                        <a href="#">基础资料</a>
                        <ul>
                            <li><a href="#" id="data-synchron">同步资料</a></li>
                            <li><a href="<%= this.GetRouteUrl("vendor",new { }) %>">浏览供应商</a></li>
                            <li><a href="<%= this.GetRouteUrl("vendor-add",new { }) %>">新增供应商</a></li>
                             <li><a href="<%= this.GetRouteUrl("Material-price",new { }) %>">货品结算价设置</a></li>
                        </ul>
                    </li>
                    <!--<li>
                    <a href="#" >提报方案</a>
                    <ul>
                        <li><a href="<%= this.GetRouteUrl("solution", new { }) %>" >浏览方案</a></li>
                        <li><a href="<%= this.GetRouteUrl("solution-add", new { }) %>" >新增方案</a></li>
                    </ul>
                </li>-->
                    <li>
                        <a href="#">提报方案</a>
                        <ul>
                            <li><a href="<%= this.GetRouteUrl("solution", new { }) %>">浏览方案</a></li>
                            <li><a href="<%= this.GetRouteUrl("solution-add", new { }) %>">新增方案</a></li>
                            <!--<li><a href="<%= this.GetRouteUrl("shop",new{vid="" }) %>" >设置权限</a></li>
                        <li><a href="<%= this.GetRouteUrl("shop-map",new{vid="" }) %>">店铺关联</a></li>-->
                        </ul>
                    </li>
                    <!--<li><a href="#">手动采集</a></li>-->
                    <li><a href="<%= this.GetRouteUrl("rpt-default", new { }) %>">提报报表</a></li>
                    -->
                <li><a href="<%= this.GetRouteUrl("log", new { }) %>">日志管理</a></li>
                <li id="syscontrol"><a href="<%= this.GetRouteUrl("syscontrol", new { }) %>">店铺管控设置</a></li>
                    <script type="text/javascript">
                        var userCode = "<%= this._UserCode %>";
                        $(document).ready(function () {
                            $("#syscontrol").hide();
                            if (userCode == "hkshop") {
                                $("#syscontrol").show();
                            }
                        });
                    </script>
                </ul>
            </div>
        </div>

        <div class="content">

            <!--密码修改-->
            <div id="password-moidfy-ui" class="hidden">
                <div class="wrapper">
                    <p class="password">
                        <asp:Literal ID="ltlByPast" runat="server" /></p>
                    <label for="name">旧密码&nbsp;&nbsp;&nbsp;</label>
                    <input type="password" name="password" id="txtOld" class="text ui-widget-content ui-corner-all" />
                    <p></p>
                    <label for="email">新密码&nbsp;&nbsp;&nbsp;</label>
                    <input type="password" name="password" id="txtNew" value="" class="text ui-widget-content ui-corner-all" />
                </div>
            </div>

            <asp:ContentPlaceHolder ID="cpBody" runat="server"></asp:ContentPlaceHolder>
        </div>

        <div class="action">
            <asp:ContentPlaceHolder ID="cpAction" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
